# ====================================
# AI-SAHAYAK ENVIRONMENT VARIABLES
# ====================================

# DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/ai_sahayak"

# API KEYS (REQUIRED)
GEMINI_API_KEY=your_gemini_api_key_here
BYTEZ_API_KEY=your_bytez_api_key_here

# SECURITY
JWT_SECRET=change_this_to_a_secure_random_string_in_production

# REDIS (OPTIONAL - for caching market data and API responses)
REDIS_URL=redis://localhost:6379

# S3-COMPATIBLE STORAGE (OPTIONAL - for audio and document storage)
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=ai-sahayak-storage
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_REGION=us-east-1

# OCR SERVICE
OCR_SPACE_API_KEY=your_ocr_space_api_key_here

# APPLICATION
PORT=5000
NODE_ENV=development
